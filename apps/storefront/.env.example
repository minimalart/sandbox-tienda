# Storefront environment variables — boilerplate

# Public URL of this storefront
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Medusa backend
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Publishable API key — get it from Medusa Admin -> Settings -> API Keys
# after running pnpm setup:medusa (the seed script prints it)
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_83aac6945d22924dcf43f4f30d1279d873461539383f36d5df11b77b1d31b38e
NEXT_PUBLIC_SALES_CHANNEL_ID=sc_pending_operational_seed

# Admin API key — only required if any server route calls the admin API directly
MEDUSA_ADMIN_API_KEY=

# Default country/region (ISO 2-letter code)
NEXT_PUBLIC_COUNTRY_CODE=ar
NEXT_PUBLIC_DEFAULT_REGION=ar

# Stripe (optional) — leave empty to disable Stripe payment UI
NEXT_PUBLIC_STRIPE_KEY=

# Google Maps (optional) — when absent the checkout address form renders without a map
GOOGLE_MAPS_API_KEY=

# Sucursales (multi-branch): se configura en Admin → Preferencias, NO por env.
# Apagado por default ⇒ la tienda usa un único canal (NEXT_PUBLIC_SALES_CHANNEL_ID).

# Typesense search
NEXT_PUBLIC_TYPESENSE_NODE_HOST=localhost
NEXT_PUBLIC_TYPESENSE_NODE_PORT=8109
NEXT_PUBLIC_TYPESENSE_NODE_PROTOCOL=http
NEXT_PUBLIC_TYPESENSE_SEARCH_API_KEY=dev_typesense_api_key
NEXT_PUBLIC_TYPESENSE_COLLECTION_NAME=products

# Maintenance mode
NEXT_PUBLIC_MAINTENANCE_MODE=false

# Google login (optional) — show the "Continuar con Google" button only when "true".
# The backend must also have GOOGLE_CLIENT_ID/SECRET set for the flow to work.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
# Sentry (opcional — error monitoring). Sin NEXT_PUBLIC_SENTRY_DSN, Sentry queda
# desactivado y el build/runtime no cambian. Crear el proyecto en sentry.io.
NEXT_PUBLIC_SENTRY_DSN=
# Nombre del entorno reportado (default: NODE_ENV)
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# Muestreo de performance tracing en el browser 0..1 (default 0)
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
# Tracing del lado servidor 0..1 (default 0)
SENTRY_TRACES_SAMPLE_RATE=
# Subida de sourcemaps en build (opcional). Sin estos, no se suben y el build no rompe.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
# Ruta tunnel opcional para esquivar ad-blockers (ej: /monitoring)
NEXT_PUBLIC_SENTRY_TUNNEL_ROUTE=
# Kill-switch: false en local/develop no envía nada aunque haya DSN (default: true)
NEXT_PUBLIC_SENTRY_ENABLED=
