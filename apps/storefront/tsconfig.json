{
  "compilerOptions": {
    "target": "es5",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "baseUrl": "./src",
    "paths": {
      "@lib/util/money": ["../node_modules/@minimalart/mercatto-plugin-storefront-shared/dist/util/money"],
      "@lib/util/get-individual-variant": ["../node_modules/@minimalart/mercatto-plugin-storefront-shared/dist/util/get-individual-variant"],
      "@lib/util/is-product-in-stock": ["../node_modules/@minimalart/mercatto-plugin-storefront-shared/dist/util/is-product-in-stock"],
      "@lib/util/free-shipping-target": ["../node_modules/@minimalart/mercatto-plugin-storefront-shared/dist/util/free-shipping-target"],
      "@lib/util/cn": ["../node_modules/@minimalart/mercatto-plugin-storefront-shared/dist/util/cn"],
      "@lib/util/placeholder-image": ["../node_modules/@minimalart/mercatto-plugin-storefront-shared/dist/util/placeholder-image"],
      "@lib/stores/recently-viewed.store": ["../node_modules/@minimalart/mercatto-plugin-storefront-shared/dist/stores/recently-viewed.store"],
      "@modules/common/components/checkbox-input": ["../node_modules/@minimalart/mercatto-plugin-storefront-shared/dist/components/checkbox-input"],
      "@modules/common/components/scroll-carousel": ["../node_modules/@minimalart/mercatto-plugin-storefront-shared/dist/components/scroll-carousel"],
      "@modules/common/components/product-image": ["../node_modules/@minimalart/mercatto-plugin-storefront-shared/dist/components/product-image"],
      "@/*": [
        "*"
      ],
      "@lib/*": [
        "lib/*"
      ],
      "@modules/*": [
        "modules/*"
      ],
      "@pages/*": [
        "pages/*"
      ]
    },
    "plugins": [
      {
        "name": "next"
      }
    ],
    "strictNullChecks": true
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    ".nyc_output",
    "coverage",
    "jest-coverage",
    "**/*.test.ts",
    "**/*.test.tsx",
    "tests"
  ]
}
