# DigitalOcean builds apps/backend with the Heroku Node buildpack, which uses
# npm (the pnpm-lock.yaml lives at the monorepo root and isn't seen here).
# npm 7+ is strict about peer deps, and the @medusajs packages pin several of
# theirs to EXACT versions that the tree cannot all satisfy at once — e.g.
# @medusajs/loyalty-plugin and @medusajs/dashboard both require
# react-router-dom@6.30.4 while another branch of the tree resolves 6.30.3, and
# @medusajs/utils requires express@^4.21.0 against a v5 in the tree.
# pnpm tolerates these with warnings, npm fails hard. Allow the install to proceed.
# Scoped to apps/backend so it only affects the npm-based DO build, not root pnpm.
legacy-peer-deps=true
install-links=true

# GitHub Packages routing for @minimalart scope.
#
# The DO build reads `GITHUB_TOKEN` from the App environment (Settings → Backend
# component → Environment Variables → Type: SECRET, Scope: BUILD_TIME).
# The token needs `read:packages` on the `minimalart` org.
@minimalart:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
always-auth=true
