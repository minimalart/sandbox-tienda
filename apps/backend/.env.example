# Database (matches infra/docker-compose.yml)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/medusa

# Redis (optional — falls back to in-memory if unset)
REDIS_URL=redis://localhost:6380
# Familia de DNS de ioredis: 4 (IPv4), 6 (IPv6) o vacío/0 (dual-stack, default).
# Poner 4 si el backend arranca con `connect ETIMEDOUT` contra el Redis/Valkey:
# en DO el lookup dual-stack resuelve IPv6 primero y la conexión que BullMQ
# duplica para consumir eventos se cuelga en el handshake TLS. Síntoma: los mails
# de orden, el WhatsApp y el outbox del ERP dejan de salir con el proceso sano.
# REDIS_FAMILY=4

# Auth secrets — CHANGE IN PRODUCTION
JWT_SECRET=change_me_jwt_secret
COOKIE_SECRET=change_me_cookie_secret

# Clave dedicada con la que se cifra TODO lo que el backend guarda en reposo: las
# credenciales de integración por tienda (site_credential) y los settings secretos
# (site_setting). Tiene que ser un valor PROPIO.
#
# Sin ella, la cadena de claves de lib/shared/encryption-key.ts cae a JWT_SECRET, y
# entonces rotar el JWT_SECRET —que es la maniobra estándar para invalidar todas las
# sesiones— vuelve INDESCIFRABLES todas las credenciales guardadas. Sin un error al
# arrancar: el síntoma aparece recién cuando alguien intenta despachar o cobrar.
#
# Se cifra siempre con esta y se descifra probando también APP_SETTINGS_ENC_KEY y
# JWT_SECRET, así que agregarla a un proyecto existente NO rompe nada: los blobs
# viejos se siguen leyendo y migran al reescribirse. Lo que SÍ es destructivo es
# SACAR del entorno una clave con la que todavía haya blobs cifrados.
CREDENTIAL_ENCRYPTION_KEY=change_me_credential_encryption_key

# CORS
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:3000,http://localhost:9000

# Server
PORT=9000

# Admin user (used by `pnpm setup:db`)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=supersecret

# Typesense (matches infra/docker-compose.yml)
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8109
TYPESENSE_PROTOCOL=http
TYPESENSE_API_KEY=dev_typesense_api_key
TYPESENSE_COLLECTION_NAME=products
# Reconciliación periódica: red de seguridad para cambios de STOCK por nivel,
# que en Medusa v2 no emiten evento (los subscribers cubren producto y precio en
# tiempo real). Poné TYPESENSE_RECONCILE_ENABLED=false para desactivarla.
TYPESENSE_RECONCILE_CRON=*/15 * * * *
TYPESENSE_RECONCILE_ENABLED=true

# Stripe (optional — provider registers only when set)
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# MercadoPago (optional — provider registers only when MERCADOPAGO_ACCESS_TOKEN is set)
# Two independent flows share the same credentials/accounts:
#   - Checkout Express (redirect / Checkout Pro): MERCADOPAGO_ENABLED=true
#   - Checkout API (embedded Payment Brick, cards/cash/installments/saved cards):
#     MERCADOPAGO_API_ENABLED=true
# Which one each demo shows is set per-demo via content_config.mercadopagoCheckoutMode
# ('express' | 'api' | 'both'). The API flow needs MERCADOPAGO_PUBLIC_KEY (per account).
MERCADOPAGO_ENABLED=
MERCADOPAGO_API_ENABLED=
# Global account (single-tenant fallback):
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_PUBLIC_KEY=
# Per-branch accounts (optional). JSON map keyed by branch code (or sales_channel_id):
# each branch collects with its own MP account. When a cart's branch matches a key
# that account is used; otherwise the global token above is the fallback.
# Example: {"ESCOBAR":{"accessToken":"APP_USR-...","webhookSecret":"...","publicKey":"..."},"PILAR":{...}}
MERCADOPAGO_ACCOUNTS=

# Vimeo (optional — admin muestra "no conectado" hasta setear credenciales)
# Para OAuth: CLIENT_ID + CLIENT_SECRET. Atajo: VIMEO_ACCESS_TOKEN (personal token, saltea OAuth)
VIMEO_CLIENT_ID=
VIMEO_CLIENT_SECRET=
VIMEO_ACCESS_TOKEN=
VIMEO_FOLDER_URI=
# BACKEND_URL se usa para construir el redirect_uri de OAuth (default http://localhost:9000)
BACKEND_URL=http://localhost:9000

# Google login (optional) — register the Auth google provider only when set.
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
# GOOGLE_CALLBACK_URL must point to the storefront callback page (NOT the backend).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/ar/google-callback

# Google Maps en el admin (opcional) — habilita el buscador de direcciones y el
# mapa con marcador del form de Sucursales (Maps JavaScript API + Places API).
# Prefijo VITE_ porque lo consume el admin de Medusa (Vite) via import.meta.env.
# Sin la key, el form degrada a los inputs manuales de provincia/ciudad/lat/lng.
VITE_GOOGLE_MAPS_API_KEY=

# URL del storefront — la usa el link "Preview" del editor de Landing Pages para
# abrir la pagina publicada en el front (no en el backend). Sin esto, el preview
# resuelve contra el origen del admin y devuelve "Cannot GET /l/<slug>".
# Prefijo VITE_ porque lo consume el admin de Medusa (Vite) via import.meta.env.
VITE_STOREFRONT_URL=http://localhost:3000

# Emails transaccionales (SendGrid). El modulo de email (src/modules/email) se
# registra siempre; sin SENDGRID_API_KEY los envios se loguean en consola en
# vez de mandarse por SendGrid.
SENDGRID_API_KEY=
# Remitente (from) de los emails. Por entorno/proyecto.
EMAIL_FROM=noreply@mercatto.com
# Template del registry que manda `pnpm email:test` (default: customer-register).
EMAIL_TEST_TEMPLATE=
# Destinatario por defecto del test (si no, cae a ADMIN_EMAIL).
SENDGRID_TEST_TO=
# Bucket publico de iconos para los emails (opcional). Sin esto, los iconos no
# se renderizan pero los emails se mandan igual.
EMAIL_ICONS_BASE_URL=

# === Almacenamiento de archivos (S3 / DigitalOcean Spaces) ===
# Si S3_BUCKET esta seteado, se registra el provider S3 para uploads (imagenes de
# marcas, banners, etc.). Sin esto, Medusa usa disco local (efimero en el deploy:
# los archivos se pierden al reiniciar). S3-compatible: AWS S3 o DO Spaces.
# file_url = URL publica base (CDN/origin) con la que se arman las URLs devueltas.
S3_FILE_URL=
# endpoint = endpoint de la API S3 (ej DO Spaces: https://nyc3.digitaloceanspaces.com)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Prefijo opcional para namespacar los objetos dentro del bucket (ej: "uploads").
S3_PREFIX=
# --- Gift Card Experience (opt-in) ---
# Habilitar solo después de migrar, auditar duplicados y activar settings en Admin.
GIFT_CARD_EXPERIENCE_ENABLED=false
# Secreto estable de al menos 32 caracteres. Nunca rotarlo sin un plan de re-cifrado.
GIFT_CARD_TOKEN_SECRET=
# Clave pública ECDSA del Event Webhook firmado de SendGrid.
SENDGRID_EVENT_WEBHOOK_PUBLIC_KEY=
# Sentry (opcional — error monitoring). Sin SENTRY_DSN, Sentry queda desactivado
# y el backend arranca normal. Crear el proyecto en sentry.io y pegar el DSN.
SENTRY_DSN=
# Nombre del entorno reportado (default: NODE_ENV)
SENTRY_ENVIRONMENT=
# Versión/release para agrupar errores (opcional)
SENTRY_RELEASE=
# Muestreo de performance tracing 0..1 (default 0 = apagado)
SENTRY_TRACES_SAMPLE_RATE=
# Kill-switch: false en local/develop no envía nada aunque haya DSN (default: true)
SENTRY_ENABLED=

# --- Landing Builder AI (OpenRouter) ---
# OpenRouter (https://openrouter.ai) es compatible con la API Chat Completions
# de OpenAI: un solo cliente sirve para cualquier modelo. La key vive SOLO en el
# backend (nunca se expone al admin/storefront). Sin key, los endpoints AI
# responden 503 con mensaje claro.
OPENROUTER_API_KEY=
# URL del sitio para atribución en OpenRouter (opcional).
OPENROUTER_SITE_URL=
#
# NOTA: el modelo de texto, los reintentos, el modelo/calidad/peso de imágenes y
# la config del Asistente IA YA NO se manejan por env: se gestionan desde el
# admin en Preferencias → "Configuración IA" (módulo store-config). Las vars de
# abajo son OPCIONALES y sólo siembran el valor por defecto la primera vez (compat
# con deployments existentes); una vez guardada la config en la UI, manda la UI.
# Sólo OPENROUTER_API_KEY (secreto) y OPENROUTER_SITE_URL siguen siendo env.
#
# (deprecado / seed) Modelo de texto en formato proveedor/modelo.
OPENROUTER_MODEL=openai/gpt-4.1-mini
# (deprecado / seed) Reintentos del generador cuando la IA devuelve JSON inválido.
LANDING_AI_MAX_RETRIES=2

# --- MCP server (mcp-medusa) montado en /mcp ---
# Endpoint MCP (Model Context Protocol) co-desplegado dentro del backend. Expone
# las tools de la Admin API a asistentes de IA (Streamable HTTP en POST /mcp).
# Si no se setean estas vars, el endpoint igual se monta pero la auth fallará y
# los tools no podrán llamar a Medusa.
#
# URL de la Admin API a la que pegan los tools. Si NO se setea, se usa
# automáticamente BACKEND_URL (la URL pública del backend). En local podés dejar
# http://localhost:9000.
MEDUSA_BASE_URL=http://127.0.0.1:9000
# Tipo de auth de los tools contra la Admin API: api-key | jwt | session.
MEDUSA_AUTH_TYPE=api-key
# API key admin (secret) con la que los tools operan la Admin API. Reusar el
# mismo admin key del storefront o generar uno dedicado al MCP.
MEDUSA_API_KEY=
# Si la API key debe ir en Basic base64 (`key:`) en vez de cruda (default: false).
MEDUSA_API_KEY_BASE64=false
# Auth de los CLIENTES que pegan a /mcp: se gestiona con API keys generadas
# desde el admin (Asistente IA → Configuración → API Keys del MCP). Se guarda el
# hash en DB; revocación/rotación/métricas por key. NO hace falta setear nada acá.
#
# MCP_AUTH_TOKEN queda como FALLBACK opcional (un único bearer por env), por si
# se quiere un token fijo sin pasar por la UI. Dejar vacío si usás API keys.
MCP_AUTH_TOKEN=

# --- Asistente IA (extensión Chat IA del admin) ---
# Usa la MISMA API key que el builder de Puck (OPENROUTER_API_KEY) pero con su
# propio modelo. Las tools del asistente pegan a la Admin API con MEDUSA_BASE_URL
# + MEDUSA_API_KEY (las mismas del MCP de arriba).
#
# (deprecado / seed) Igual que arriba: modelo, razonamiento y tokens del Asistente
# se gestionan desde Preferencias → "Configuración IA". Estas vars sólo siembran
# el default inicial.
CHAT_AI_MODEL=openai/gpt-5-mini
# (deprecado / seed) Esfuerzo de razonamiento (gpt-5*, o*): minimal|low|medium|high.
# Con 'medium'/'high' el modelo puede gastar el presupuesto razonando y devolver
# respuesta vacía. OpenRouter lo ignora en modelos sin razonamiento.
CHAT_AI_REASONING_EFFORT=low
# (deprecado / seed) Tope de tokens de salida por vuelta (incluye reasoning tokens).
CHAT_AI_MAX_TOKENS=6000

# --- Carritos abandonados (extensión abandoned-cart) ---
# Detección + secuencia de recordatorios (email/WhatsApp) sobre carritos sin
# completar. El detalle del carrito se relee en vivo; el módulo solo orquesta.
ABANDONED_CART_ENABLED=true
# Frecuencia del barrido (cron). Default cada 15 min.
ABANDONED_CART_SCAN_CRON=*/15 * * * *
# Horas de inactividad para cada paso de la secuencia (acumuladas desde la última
# actividad del carrito).
ABANDONED_CART_STEP1_HOURS=1
ABANDONED_CART_STEP2_HOURS=24
ABANDONED_CART_STEP3_HOURS=72
# Carritos por página de la detección y tope de páginas por corrida: el barrido
# recorre la ventana completa paginando, así que el máximo por corrida es
# BATCH_SIZE * MAX_PAGES. Si se alcanza el tope, se loguea un warning.
ABANDONED_CART_BATCH_SIZE=100
ABANDONED_CART_MAX_PAGES=20
# Edad máxima: cierra la ventana de recuperación (no se molesta a carritos más
# viejos que esto). Se aplica como filtro SQL de la detección.
ABANDONED_CART_MAX_AGE_HOURS=336
# URL base del storefront para armar el link de recuperación (si falta, se usa
# path relativo). El país por defecto se usa cuando el carrito no lo expone.
STOREFRONT_URL=
STOREFRONT_DEFAULT_COUNTRY=cl
# Nombres de los templates de WhatsApp APROBADOS en Meta/Kapso, uno por paso. Si
# no se setean, el paso de WhatsApp se OMITE (email sigue funcionando).
KAPSO_TEMPLATE_CART_ABANDONED_1=
KAPSO_TEMPLATE_CART_ABANDONED_2=
KAPSO_TEMPLATE_CART_ABANDONED_3=

# --- Newsletter / Brevo ---
# Alta de contactos del formulario del storefront en una lista de Brevo.
# Las cuatro se EDITAN desde el admin (Ajustes → Newsletter (Brevo)) y se resuelven
# POR TIENDA: esto es sólo la capa de arranque para la primera. Sin BREVO_API_KEY o
# sin BREVO_LIST_ID el alta se guarda igual y queda como "Sin configurar" en la
# pantalla de Newsletter — nunca se pierde el contacto ni se le miente al visitante.
# BREVO_LIST_ID es el número de la lista en Brevo → Contactos → Listas.
BREVO_API_KEY=
BREVO_LIST_ID=
# Kill switch de la sincronización (default true) y override de la API (default
# https://api.brevo.com/v3, sólo para apuntar a un doble de prueba).
NEWSLETTER_ENABLED=
BREVO_API_URL=

# --- WhatsApp / Kapso ---
# Credenciales del proyecto Kapso (proxy de la WhatsApp Cloud API de Meta). Sin
# KAPSO_API_KEY + KAPSO_PHONE_NUMBER_ID el provider corre en modo "solo log" (no
# envía). KAPSO_BUSINESS_ACCOUNT_ID (WABA) hace falta para gestionar templates.
KAPSO_API_KEY=
KAPSO_PHONE_NUMBER_ID=
KAPSO_BUSINESS_ACCOUNT_ID=
# Override de la base de la API (default https://api.kapso.ai) e idioma default de
# los templates (default es).
KAPSO_BASE_URL=
KAPSO_TEMPLATE_LANG=es
# URL del "Inbox Embed" de Kapso para el iframe del admin (WhatsApp → Inbox).
KAPSO_INBOX_EMBED_URL=
# Bot entrante (webhook /webhooks/kapso): secret HMAC con el que Kapso firma el
# payload (header x-webhook-signature) y token del challenge de verificación (GET).
KAPSO_WEBHOOK_SECRET=
KAPSO_WEBHOOK_VERIFY_TOKEN=
# Compra por WhatsApp: contexto de orden (canal/región/país) para armar el carrito
# y el link de pago. Opcionales: si se omiten, se resuelve el país por
# STOREFRONT_DEFAULT_COUNTRY, su región, y el "Default Sales Channel".
WHATSAPP_SALES_CHANNEL_ID=
WHATSAPP_REGION_ID=
WHATSAPP_COUNTRY_CODE=
# Compra por WhatsApp: al ofrecer productos, el bot manda un CARRUSEL con fotos
# (tarjeta = imagen + nombre/precio + botón "Agregar"). WhatsApp exige imagen por
# tarjeta: esta es la imagen genérica para productos SIN foto propia (URL pública,
# ej. un logo en S3). Si NO se setea y algún resultado no tiene foto, ese turno cae
# a la lista de texto (sin carrusel).
WHATSAPP_PLACEHOLDER_IMAGE_URL=
# Handoff a humano: horas sin actividad tras las que una conversación derivada a
# una persona vuelve sola al bot (default 6).
WHATSAPP_HANDOFF_AUTO_RESUME_HOURS=6
# FAQ/knowledge del bot (RAG): el bot busca en la memoria del Asistente IA
# (entradas tipo 'faq' cargadas en el backoffice). Requiere memoria activa
# (AI_MEMORY_ENABLED=true) + OPENROUTER_API_KEY para los embeddings. Sin esto el
# bot funciona igual pero sin base de conocimiento.
AI_MEMORY_ENABLED=

# --- ARCA (ex AFIP): consulta de constancia de inscripción -------------------
# Autocompleta los datos de Factura A en el checkout (botón "Buscar en ARCA").
# Sin estas vars el endpoint /store/arca/taxpayer-lookup responde 503 y el
# checkout sigue funcionando con carga manual. El cert X.509 debe estar
# autorizado para el servicio ws_sr_constancia_inscripcion (Administración de
# Certificados Digitales). NUNCA commitear el cert ni la clave.
ARCA_CUIT_REPRESENTADA=
# Cert y clave privada: acepta el PEM crudo pegado directo (multilínea o con
# \n escapados) o el PEM codificado base64 en una línea. Alternativa:
# ARCA_CERTIFICATE_PATH / ARCA_PRIVATE_KEY_PATH apuntando a archivos montados
# (los *_BASE64 tienen prioridad).
ARCA_CERTIFICATE_BASE64=
ARCA_PRIVATE_KEY_BASE64=
# production | homologacion (default production).
ARCA_ENVIRONMENT=production
# Servicio WSAA a autorizar (default ws_sr_constancia_inscripcion).
ARCA_WSAA_SERVICE=
