{
  "name": "@minimalart/mercatto-analytics-contract",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm build"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "exports": {
    "./orders": {
      "types": "./dist/orders.d.ts",
      "default": "./dist/orders.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./aggregate": {
      "types": "./dist/aggregate.d.ts",
      "default": "./dist/aggregate.js"
    },
    "./facts": {
      "types": "./dist/facts.d.ts",
      "default": "./dist/facts.js"
    }
  }
}
