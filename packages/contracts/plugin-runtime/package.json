{
  "name": "@minimalart/mercatto-plugin-runtime",
  "version": "0.5.0",
  "description": "Runtime coordination contract between Mercatto host and plugins: sync readers for app-settings snapshots, external host-side module getters, and React UI slots the host can register (SiteScopeBar, etc.) so published plugins render the same admin chrome as in-tree extensions.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./admin": {
      "types": "./dist/admin/index.d.ts",
      "default": "./dist/admin/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minimalart/medusa-b2c-boilerplate.git",
    "directory": "packages/contracts/plugin-runtime"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "private": false,
  "peerDependencies": {
    "react": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "react": "^18.3.1",
    "typescript": "^5.6.3"
  }
}
