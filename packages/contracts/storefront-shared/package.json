{
  "name": "@minimalart/mercatto-storefront-shared",
  "version": "0.1.0",
  "description": "Storefront-side shared primitives for Mercatto: portable utils, presentational components, a recently-viewed store, and a ports+provider contract that plugins can consume without pulling the whole storefront tree. First consumer: @minimalart/mercatto-plugin-storefront-recommendations. Splits `apps/storefront/src/lib/` and `apps/storefront/src/modules/common/` at the seam between 'pure & portable' and 'host-coupled'.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "package.json",
    "README.md"
  ],
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ports": {
      "types": "./dist/ports/index.d.ts",
      "default": "./dist/ports/index.js"
    },
    "./provider": {
      "types": "./dist/provider/index.d.ts",
      "default": "./dist/provider/index.js"
    },
    "./util/money": {
      "types": "./dist/util/money.d.ts",
      "default": "./dist/util/money.js"
    },
    "./util/get-individual-variant": {
      "types": "./dist/util/get-individual-variant.d.ts",
      "default": "./dist/util/get-individual-variant.js"
    },
    "./util/is-product-in-stock": {
      "types": "./dist/util/is-product-in-stock.d.ts",
      "default": "./dist/util/is-product-in-stock.js"
    },
    "./util/free-shipping-target": {
      "types": "./dist/util/free-shipping-target.d.ts",
      "default": "./dist/util/free-shipping-target.js"
    },
    "./util/cn": {
      "types": "./dist/util/cn.d.ts",
      "default": "./dist/util/cn.js"
    },
    "./util/placeholder-image": {
      "types": "./dist/util/placeholder-image.d.ts",
      "default": "./dist/util/placeholder-image.js"
    },
    "./stores/recently-viewed": {
      "types": "./dist/stores/recently-viewed.store.d.ts",
      "default": "./dist/stores/recently-viewed.store.js"
    },
    "./components/checkbox-input": {
      "types": "./dist/components/checkbox-input.d.ts",
      "default": "./dist/components/checkbox-input.js"
    },
    "./components/scroll-carousel": {
      "types": "./dist/components/scroll-carousel.d.ts",
      "default": "./dist/components/scroll-carousel.js"
    },
    "./components/product-image": {
      "types": "./dist/components/product-image.d.ts",
      "default": "./dist/components/product-image.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "react": "^18 || ^19",
    "react-dom": "^18 || ^19",
    "next": "^15 || ^16",
    "@medusajs/js-sdk": "^2.18",
    "@medusajs/types": "^2.18",
    "@medusajs/ui": "^4"
  },
  "dependencies": {
    "zustand": "^5.0.8",
    "@heroicons/react": "^2.1.5"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "next": "^16",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minimalart/medusa-b2c-boilerplate.git",
    "directory": "packages/contracts/storefront-shared"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "private": false
}
