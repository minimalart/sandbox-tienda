{
  "name": "@repo/project-composer",
  "version": "1.0.0",
  "private": true,
  "bin": { "mercatto-site": "src/cli.js" },
  "scripts": {
    "extract": "node src/extract-components.js",
    "validate:components": "node src/validate-components.js",
    "verify:components": "node src/verify-components.js",
    "build": "node --check src/index.js && node --check src/cli.js",
    "typecheck": "node --check src/index.js && node --check src/cli.js",
    "test": "node --test src/index.test.js"
  },
  "dependencies": {
    "@repo/project-catalog": "workspace:*"
  }
}
