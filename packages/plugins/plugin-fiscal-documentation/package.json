{
  "name": "@minimalart/mercatto-plugin-fiscal-documentation",
  "version": "1.0.4",
  "description": "Mercatto plugin — versioned fiscal documentation (constancias de inscripción de ARCA) with per-owner history, snapshot diff and PDF generation, bundled with the ARCA WSAA/padrón client. Migrated from packages/extensions/fiscal-documentation.",
  "main": ".medusa/server/src/index.js",
  "types": ".medusa/server/src/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./.medusa/server/src/index.d.ts",
      "default": "./.medusa/server/src/index.js"
    },
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./.medusa/server/src/providers/*": "./.medusa/server/src/providers/*/index.js",
    "./modules/fiscal-documentation": {
      "types": "./.medusa/server/src/modules/fiscal-documentation/index.d.ts",
      "default": "./.medusa/server/src/modules/fiscal-documentation/index.js"
    },
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    }
  },
  "files": [
    ".medusa",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "mercatto-plugin.json"
  ],
  "keywords": [
    "medusa-plugin",
    "mercatto",
    "fiscal-documentation",
    "arca",
    "afip",
    "argentina",
    "b2b"
  ],
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "2.18.0",
    "@medusajs/core-flows": "2.18.0",
    "@medusajs/framework": "2.18.0",
    "@medusajs/icons": "2.18.0",
    "@medusajs/js-sdk": "2.18.0",
    "@medusajs/medusa": "2.18.0",
    "@medusajs/ui": "^4.1.19",
    "@medusajs/utils": "2.18.0",
    "@mikro-orm/core": "6.4.13",
    "@mikro-orm/knex": "6.4.13",
    "@mikro-orm/migrations": "6.4.13",
    "@mikro-orm/postgresql": "6.4.13",
    "@tanstack/react-query": "^5.62.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "@medusajs/core-flows": {
      "optional": true
    },
    "@medusajs/js-sdk": {
      "optional": true
    },
    "@medusajs/utils": {
      "optional": true
    }
  },
  "dependencies": {
    "@minimalart/mercatto-plugin-runtime": "workspace:^",
    "fast-xml-parser": "^5.10.1",
    "node-forge": "^1.4.0",
    "pdf-lib": "^1.17.1",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@types/node-forge": "^1.3.14",
    "@medusajs/admin-sdk": "2.18.0",
    "@medusajs/admin-shared": "2.18.0",
    "@medusajs/cli": "2.18.0",
    "@medusajs/core-flows": "2.18.0",
    "@medusajs/framework": "2.18.0",
    "@medusajs/icons": "2.18.0",
    "@medusajs/js-sdk": "2.18.0",
    "@medusajs/medusa": "2.18.0",
    "@medusajs/ui": "^4.1.19",
    "@medusajs/utils": "2.18.0",
    "@mikro-orm/core": "6.4.13",
    "@mikro-orm/knex": "6.4.13",
    "@mikro-orm/migrations": "6.4.13",
    "@mikro-orm/postgresql": "6.4.13",
    "@tanstack/react-query": "^5.62.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minimalart/medusa-b2c-boilerplate.git",
    "directory": "packages/plugins/plugin-fiscal-documentation"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "private": false
