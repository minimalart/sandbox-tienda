{
  "name": "@minimalart/mercatto-plugin-landing-pages",
  "version": "1.0.1",
  "description": "Mercatto plugin — visual-built (Puck) landing pages with AI-assisted content generation, publishing and per-sales-channel scoping. Migrated from packages/extensions/landing-pages.",
  "main": ".medusa/server/src/index.js",
  "types": ".medusa/server/src/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./.medusa/server/src/index.d.ts",
      "default": "./.medusa/server/src/index.js"
    },
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./.medusa/server/src/providers/*": "./.medusa/server/src/providers/*/index.js",
    "./modules/landing-page": {
      "types": "./.medusa/server/src/modules/landing-page/index.d.ts",
      "default": "./.medusa/server/src/modules/landing-page/index.js"
    },
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    }
  },
  "files": [
    ".medusa",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "mercatto-plugin.json"
  ],
  "keywords": [
    "medusa-plugin",
    "mercatto",
    "landing-pages",
    "puck",
    "ai"
  ],
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "2.18.0",
    "@medusajs/core-flows": "2.18.0",
    "@medusajs/framework": "2.18.0",
    "@medusajs/icons": "2.18.0",
    "@medusajs/js-sdk": "2.18.0",
    "@medusajs/medusa": "2.18.0",
    "@medusajs/ui": "^4.1.19",
    "@medusajs/utils": "2.18.0",
    "@mikro-orm/core": "6.4.13",
    "@mikro-orm/knex": "6.4.13",
    "@mikro-orm/migrations": "6.4.13",
    "@mikro-orm/postgresql": "6.4.13",
    "@tanstack/react-query": "^5.62.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "@medusajs/core-flows": {
      "optional": true
    },
    "@medusajs/js-sdk": {
      "optional": true
    },
    "@medusajs/utils": {
      "optional": true
    }
  },
  "dependencies": {
    "@minimalart/mercatto-plugin-runtime": "workspace:^",
    "@measured/puck": "0.20.2",
    "sharp": "^0.33.5",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "2.18.0",
    "@medusajs/admin-shared": "2.18.0",
    "@medusajs/cli": "2.18.0",
    "@medusajs/core-flows": "2.18.0",
    "@medusajs/framework": "2.18.0",
    "@medusajs/icons": "2.18.0",
    "@medusajs/js-sdk": "2.18.0",
    "@medusajs/medusa": "2.18.0",
    "@medusajs/ui": "^4.1.19",
    "@medusajs/utils": "2.18.0",
    "@mikro-orm/core": "6.4.13",
    "@mikro-orm/knex": "6.4.13",
    "@mikro-orm/migrations": "6.4.13",
    "@mikro-orm/postgresql": "6.4.13",
    "@tanstack/react-query": "^5.62.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minimalart/medusa-b2c-boilerplate.git",
    "directory": "packages/plugins/plugin-landing-pages"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
