{
  "name": "@minimalart/mercatto-plugin-media-library",
  "version": "1.1.4",
  "description": "Mercatto plugin — catálogo de imágenes (media assets) con picker admin, editor de imagen y widget de productos",
  "main": ".medusa/server/src/index.js",
  "types": ".medusa/server/src/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./.medusa/server/src/index.d.ts",
      "default": "./.medusa/server/src/index.js"
    },
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./.medusa/server/src/providers/*": "./.medusa/server/src/providers/*/index.js",
    "./modules/media-library": {
      "types": "./.medusa/server/src/modules/media-library/index.d.ts",
      "default": "./.medusa/server/src/modules/media-library/index.js"
    },
    "./workflows/*": {
      "types": "./.medusa/server/src/workflows/*.d.ts",
      "default": "./.medusa/server/src/workflows/*.js"
    },
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    },
    "./admin/components/media-library-picker": {
      "types": "./.medusa/server/src/admin/components/common/media-library-picker.d.ts",
      "import": "./.medusa/server/src/admin/components/common/media-library-picker.js",
      "default": "./.medusa/server/src/admin/components/common/media-library-picker.js"
    },
    "./admin/hooks/media-library": {
      "types": "./.medusa/server/src/admin/hooks/api/media-library.d.ts",
      "default": "./.medusa/server/src/admin/hooks/api/media-library.js"
    },
    "./admin/lib/image-editor": {
      "types": "./.medusa/server/src/admin/routes/media-library/components/image-editor/index.d.ts",
      "default": "./.medusa/server/src/admin/routes/media-library/components/image-editor/index.js"
    }
  },
  "files": [
    ".medusa",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "mercatto-plugin.json"
  ],
  "keywords": [
    "medusa-plugin",
    "mercatto",
    "media-library",
    "assets"
  ],
  "scripts": {
    "build": "medusa plugin:build && tsc -p tsconfig.admin-subpaths.json",
    "dev": "medusa plugin:develop",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "2.18.0",
    "@medusajs/core-flows": "2.18.0",
    "@medusajs/framework": "2.18.0",
    "@medusajs/icons": "2.18.0",
    "@medusajs/js-sdk": "2.18.0",
    "@medusajs/medusa": "2.18.0",
    "@medusajs/ui": "^4.1.19",
    "@medusajs/utils": "2.18.0",
    "@minimalart/mercatto-plugin-runtime": "workspace:*",
    "@mikro-orm/core": "6.4.13",
    "@mikro-orm/knex": "6.4.13",
    "@mikro-orm/migrations": "6.4.13",
    "@mikro-orm/postgresql": "6.4.13",
    "@tanstack/react-query": "^5.62.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "@medusajs/core-flows": {
      "optional": true
    },
    "@medusajs/js-sdk": {
      "optional": true
    },
    "@medusajs/utils": {
      "optional": true
    }
  },
  "dependencies": {
    "react-easy-crop": "^6.0.2",
    "smartcrop": "^2.0.5",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "2.18.0",
    "@medusajs/admin-shared": "2.18.0",
    "@medusajs/cli": "2.18.0",
    "@medusajs/core-flows": "2.18.0",
    "@medusajs/framework": "2.18.0",
    "@medusajs/icons": "2.18.0",
    "@medusajs/js-sdk": "2.18.0",
    "@medusajs/medusa": "2.18.0",
    "@medusajs/ui": "^4.1.19",
    "@medusajs/utils": "2.18.0",
    "@mikro-orm/core": "6.4.13",
    "@mikro-orm/knex": "6.4.13",
    "@mikro-orm/migrations": "6.4.13",
    "@mikro-orm/postgresql": "6.4.13",
    "@tanstack/react-query": "^5.62.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minimalart/medusa-b2c-boilerplate.git",
    "directory": "packages/plugins/plugin-media-library"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "private": false
}
