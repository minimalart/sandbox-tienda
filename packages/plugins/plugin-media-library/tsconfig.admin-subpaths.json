{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": ".medusa/server/src",
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "strict": false,
    "noImplicitAny": false,
    "noEmitOnError": false,
    "isolatedModules": false
  },
  "include": [
    "src/admin/components/common/media-library-picker.tsx",
    "src/admin/hooks/api/media-library.tsx",
    "src/admin/routes/media-library/components/image-editor/index.ts",
    "src/admin/routes/media-library/components/image-editor/image-editor-modal.tsx",
    "src/admin/routes/media-library/components/image-editor/image-utils.ts",
    "src/admin/routes/media-library/components/image-editor/presets.ts",
    "src/admin/routes/media-library/components/image-editor/types.ts",
    "src/admin/lib/client.ts"
  ]
}
