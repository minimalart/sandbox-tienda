{
  "name": "@minimalart/mercatto-plugin-loyalty",
  "version": "1.1.1",
  "description": "Mercatto plugin — loyalty program (points ledger + engine)",
  "main": ".medusa/server/src/index.js",
  "types": ".medusa/server/src/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./.medusa/server/src/index.d.ts",
      "default": "./.medusa/server/src/index.js"
    },
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./.medusa/server/src/providers/*": "./.medusa/server/src/providers/*/index.js",
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    },
    "./storefront/context": {
      "types": "./.medusa/server/src/storefront/context/loyalty-context.d.ts",
      "default": "./.medusa/server/src/storefront/context/loyalty-context.js"
    },
    "./storefront/account/loyalty-overview": {
      "types": "./.medusa/server/src/storefront/account/loyalty-overview/index.d.ts",
      "default": "./.medusa/server/src/storefront/account/loyalty-overview/index.js"
    },
    "./storefront/account/loyalty-rewards": {
      "types": "./.medusa/server/src/storefront/account/loyalty-rewards/index.d.ts",
      "default": "./.medusa/server/src/storefront/account/loyalty-rewards/index.js"
    },
    "./storefront/checkout/loyalty-rewards-checkout": {
      "types": "./.medusa/server/src/storefront/checkout/loyalty-rewards-checkout/index.d.ts",
      "default": "./.medusa/server/src/storefront/checkout/loyalty-rewards-checkout/index.js"
    },
    "./storefront/api/points": {
      "types": "./.medusa/server/src/storefront/api/points/route.d.ts",
      "default": "./.medusa/server/src/storefront/api/points/route.js"
    },
    "./storefront/api/loyalty/grants": {
      "types": "./.medusa/server/src/storefront/api/loyalty/grants/route.d.ts",
      "default": "./.medusa/server/src/storefront/api/loyalty/grants/route.js"
    },
    "./storefront/api/loyalty/redeem": {
      "types": "./.medusa/server/src/storefront/api/loyalty/redeem/route.d.ts",
      "default": "./.medusa/server/src/storefront/api/loyalty/redeem/route.js"
    },
    "./storefront/api/loyalty/rewards": {
      "types": "./.medusa/server/src/storefront/api/loyalty/rewards/route.d.ts",
      "default": "./.medusa/server/src/storefront/api/loyalty/rewards/route.js"
    },
    "./storefront/api/loyalty/tier": {
      "types": "./.medusa/server/src/storefront/api/loyalty/tier/route.d.ts",
      "default": "./.medusa/server/src/storefront/api/loyalty/tier/route.js"
    }
  },
  "files": [
    ".medusa",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "mercatto-plugin.json"
  ],
  "keywords": [
    "medusa-plugin",
    "mercatto",
    "loyalty",
    "points"
  ],
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@heroicons/react": "^2.0.0",
