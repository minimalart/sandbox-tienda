    "react-router-dom": "^6.0.0",
    "tus-js-client": "^4.1.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minimalart/medusa-b2c-boilerplate.git",
    "directory": "packages/plugins/plugin-videos"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "private": false
}
