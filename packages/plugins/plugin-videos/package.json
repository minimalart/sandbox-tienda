{
  "name": "@minimalart/mercatto-plugin-videos",
  "version": "1.2.3",
  "description": "Mercatto plugin — Vimeo integration for shoppable videos: admin CRUD, Vimeo OAuth flow, product-video links, storefront-facing store API.",
  "main": ".medusa/server/src/index.js",
  "types": ".medusa/server/src/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./.medusa/server/src/index.d.ts",
      "default": "./.medusa/server/src/index.js"
    },
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./.medusa/server/src/providers/*": "./.medusa/server/src/providers/*/index.js",
    "./modules/vimeo-video": {
      "types": "./.medusa/server/src/modules/vimeo-video/index.d.ts",
      "default": "./.medusa/server/src/modules/vimeo-video/index.js"
    },
    "./workflows/*": {
      "types": "./.medusa/server/src/workflows/*.d.ts",
      "default": "./.medusa/server/src/workflows/*.js"
    },
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    }
  },
  "files": [
    ".medusa",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "mercatto-plugin.json"
  ],
  "keywords": [
    "medusa-plugin",
    "mercatto",
    "videos",
    "vimeo",
    "shoppable"
  ],
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "2.18.0",
    "@medusajs/core-flows": "2.18.0",
    "@medusajs/framework": "2.18.0",
    "@medusajs/icons": "2.18.0",
    "@medusajs/js-sdk": "2.18.0",
    "@medusajs/medusa": "2.18.0",
    "@medusajs/ui": "^4.1.19",
    "@medusajs/utils": "2.18.0",
    "@minimalart/mercatto-multistore-contract": "workspace:*",
    "@minimalart/mercatto-plugin-runtime": "workspace:*",
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mikro-orm/core": "6.4.13",
    "@mikro-orm/knex": "6.4.13",
    "@mikro-orm/migrations": "6.4.13",
    "@mikro-orm/postgresql": "6.4.13",
    "@tanstack/react-query": "^5.62.0",
    "i18next": "^23.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.0",
    "react-router-dom": "^6.0.0",
    "tus-js-client": "^4.1.0"
  },
  "peerDependenciesMeta": {
    "@medusajs/core-flows": {
      "optional": true
    },
    "@medusajs/js-sdk": {
      "optional": true
    },
    "@medusajs/utils": {
      "optional": true
    },
    "tus-js-client": {
      "optional": true
    }
  },
  "dependencies": {
    "zod": "4.2.0"
  },
  "devDependencies": {
