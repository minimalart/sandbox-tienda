{
  "$schema": "https://mercatto.minimalart.co/schemas/plugin.v1.json",
  "schema_version": 1,
  "id": "videos",
  "name": "Videos",
  "version": "1.2.3",
  "kind": "plugin",
  "status": "ready",
  "dependencies": ["blog"],
  "incompatibilities": [],
  "settings_namespace": "extension:videos",
  "environment": [
    "VIMEO_ACCESS_TOKEN",
    "VIMEO_CLIENT_ID",
    "VIMEO_CLIENT_SECRET",
    "VIMEO_FOLDER_URI",
    "VIMEO_OAUTH_REDIRECT_SUCCESS"
  ],
  "medusaModuleKey": "vimeoVideo",
  "ownedTables": ["vimeo_video", "vimeo_token", "product_video_link"],
  "integrations": {
    "middlewares": [
      ["./admin/videos/middlewares", "adminVideosMiddlewares"],
      ["./admin/vimeo/middlewares", "adminVimeoMiddlewares"]
    ],
    "admin_hooks": ["videos"],
    "admin_translation": ["videos", "videos"]
  }
}
