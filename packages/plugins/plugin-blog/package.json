{
  "name": "@minimalart/mercatto-plugin-blog",
  "version": "1.0.2",
  "description": "Mercatto plugin — blog comprable con posts, categorías, configuración y linkeo a productos. Migrado desde packages/extensions/blog.",
  "main": ".medusa/server/src/index.js",
  "types": ".medusa/server/src/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./.medusa/server/src/index.d.ts",
      "default": "./.medusa/server/src/index.js"
    },
    "./.medusa/server/src/modules/*": "./.medusa/server/src/modules/*/index.js",
    "./.medusa/server/src/providers/*": "./.medusa/server/src/providers/*/index.js",
    "./modules/blog": {
      "types": "./.medusa/server/src/modules/blog/index.d.ts",
      "default": "./.medusa/server/src/modules/blog/index.js"
    },
    "./admin": {
      "import": "./.medusa/server/src/admin/index.mjs",
      "require": "./.medusa/server/src/admin/index.js",
      "default": "./.medusa/server/src/admin/index.js"
    }
  },
  "files": [
    ".medusa",
    "package.json",
    "README.md",
    "CHANGELOG.md",
    "mercatto-plugin.json"
  ],
  "keywords": [
    "medusa-plugin",
    "mercatto",
    "blog",
    "content"
  ],
  "scripts": {
    "build": "medusa plugin:build",
    "dev": "medusa plugin:develop",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@medusajs/admin-sdk": "2.18.0",
    "@medusajs/core-flows": "2.18.0",
    "@medusajs/framework": "2.18.0",
    "@medusajs/icons": "2.18.0",
    "@medusajs/js-sdk": "2.18.0",
    "@medusajs/medusa": "2.18.0",
    "@medusajs/ui": "^4.1.19",
    "@medusajs/utils": "2.18.0",
    "@mikro-orm/core": "6.4.13",
    "@mikro-orm/knex": "6.4.13",
    "@mikro-orm/migrations": "6.4.13",
    "@mikro-orm/postgresql": "6.4.13",
    "@tanstack/react-query": "^5.62.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "@medusajs/core-flows": {
      "optional": true
    },
    "@medusajs/js-sdk": {
      "optional": true
    },
    "@medusajs/utils": {
      "optional": true
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@minimalart/mercatto-plugin-runtime": "workspace:^",
    "@tiptap/core": "^2.8.0",
    "@tiptap/extension-color": "^2.8.0",
    "@tiptap/extension-highlight": "^2.8.0",
    "@tiptap/extension-image": "^2.8.0",
    "@tiptap/extension-link": "^2.8.0",
    "@tiptap/extension-table": "^2.8.0",
    "@tiptap/extension-table-cell": "^2.8.0",
    "@tiptap/extension-table-header": "^2.8.0",
    "@tiptap/extension-table-row": "^2.8.0",
    "@tiptap/extension-task-item": "^2.8.0",
    "@tiptap/extension-task-list": "^2.8.0",
    "@tiptap/extension-text-style": "^2.8.0",
    "@tiptap/extension-underline": "^2.8.0",
    "@tiptap/extension-youtube": "^2.8.0",
    "@tiptap/html": "^2.8.0",
    "@tiptap/react": "^2.8.0",
    "@tiptap/starter-kit": "^2.8.0",
    "sanitize-html": "^2.13.0",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@medusajs/admin-sdk": "2.18.0",
    "@medusajs/admin-shared": "2.18.0",
    "@medusajs/cli": "2.18.0",
    "@medusajs/core-flows": "2.18.0",
    "@medusajs/framework": "2.18.0",
    "@medusajs/icons": "2.18.0",
    "@medusajs/js-sdk": "2.18.0",
    "@medusajs/medusa": "2.18.0",
    "@medusajs/ui": "^4.1.19",
    "@medusajs/utils": "2.18.0",
    "@mikro-orm/core": "6.4.13",
    "@mikro-orm/knex": "6.4.13",
    "@mikro-orm/migrations": "6.4.13",
    "@mikro-orm/postgresql": "6.4.13",
    "@tanstack/react-query": "^5.62.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/sanitize-html": "^2.13.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minimalart/medusa-b2c-boilerplate.git",
    "directory": "packages/plugins/plugin-blog"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "private": false
