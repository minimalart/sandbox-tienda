# Root-level registry routing for Mercatto scoped packages.
# The `GITHUB_TOKEN` env var must be set at install time; both pnpm (dev) and
# npm (DigitalOcean production build) read this file when resolving
# `@minimalart/*` packages.
@minimalart:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}
